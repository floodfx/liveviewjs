{
  "name": "liveviewjs-monorepo",
  "version": "0.10.4",
  "description": "LiveViewJS brings the power of LiveView to TypeScript and JavaScript developers and applications.",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "bench": "turbo run bench",
    "lint": "turbo run lint",
    "format": "prettier --write '**/*.{ts,tsx,js,json,md}'"
  },
  "keywords": [
    "liveviewjs",
    "liveview",
    "phoenix",
    "typescript",
    "javascript",
    "bun",
    "deno",
    "cloudflare"
  ],
  "author": "Donnie Flood <donnie@floodfx.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "bun-types": "^1.3.14",
    "prettier": "^3.4.0",
    "tslib": "^2.8.1",
    "turbo": "^2.3.0",
    "typescript": "^7.0.0-rc"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
