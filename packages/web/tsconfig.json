{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["bun-types", "node"],
    "jsx": "react",
    "jsxFactory": "jsx",
    "paths": {
      "@liveviewjs/core": ["../core/src/index.ts"]
