{
  "name": "@liveviewjs/vite",
  "version": "0.10.4",
  "description": "Vite HMR Plugin and Asset Bundler for LiveViewJS",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.mjs",
    "test": "jest"
  },
  "dependencies": {
    "@liveviewjs/core": "workspace:*",
    "jsx2ttl": "^1.0.0"
  },
