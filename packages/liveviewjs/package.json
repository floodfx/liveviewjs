{
  "name": "liveviewjs",
  "version": "0.10.4",
  "description": "LiveViewJS top-level meta-package bringing the power of LiveView to TypeScript and JavaScript developers.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "test": "bun test"
  },
  "keywords": [
    "liveviewjs",
    "liveview",
    "phoenix",
    "typescript",
    "javascript"
  ],
  "author": "Donnie Flood <donnie@floodfx.com>",
  "license": "MIT",
  "dependencies": {
    "@liveviewjs/core": "workspace:*",
    "@liveviewjs/router": "workspace:*",
    "@liveviewjs/web": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^7.0.0-rc"
  }
}
